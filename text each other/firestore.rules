rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function validMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['text', 'uid', 'username', 'createdAt'])
        && d.text is string
        && d.text.size() > 0
        && d.text.size() <= 500
        && d.uid == request.auth.uid
        && d.username == myUsername()
        && d.createdAt == request.time;
    }

    // Everyone's public profile (just a username)
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$');
    }

    // Lets people find each other by username
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // Public rooms (General, Homework help, Random)
    match /rooms/{roomId}/messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && roomId in ['general', 'homework', 'random']
        && validMessage();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Private chats between two people. The chat id is "uidA_uidB".
    match /convos/{convoId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.auth.uid in convoId.split('_')
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastFrom', 'lastAt'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(convoId.split('_'))
        && request.resource.data.lastText.size() <= 80
        && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.lastAt == request.time;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in convoId.split('_');
        allow create: if signedIn()
          && request.auth.uid in convoId.split('_')
          && validMessage();
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
